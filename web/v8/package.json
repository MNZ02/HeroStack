{
  "name": "v8",
  "private": true,
  "version": "0.0.0",
  "description": "V8 Cutaway — a three.js big-block you can strip layer by layer while it turns over.",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5306 --strictPort",
    "build": "tsc --noEmit && vite build",
    "lint": "oxlint",
    "preview": "vite preview --port 5406 --strictPort",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/three": "^0.185.0",
    "oxlint": "^1.71.0",
    "typescript": "^5.9.3",
    "vite": "^8.1.1"
  }
}
